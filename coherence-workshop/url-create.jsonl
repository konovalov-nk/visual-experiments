{"kind":"spec","id":"spec.url.create","title":"URL creation","description":"Create a short link. This level observes only rows in public.urls matching the current short code.","world_id":"world.urls"}
{"kind":"world","id":"world.urls","adapter":"postgres-snapshot","projection":{"id":"projection.current-short","table":"public.urls","path":"db.urls","columns":["id","short","original"],"where":{"field":"short","equals":"input.short"}}}
{"kind":"state","id":"state.none","title":"∅","world_id":"world.urls","predicate":{"path":"db.urls","count":0}}
{"kind":"state","id":"state.url","title":"URL","world_id":"world.urls","fields":{"id":"string","short":"string","original":"string"},"predicate":{"path":"db.urls","count":1}}
{"kind":"transition","id":"transition.create","from":"state.none","to":"state.url","action":"create","input":{"short":"string","original":"string"},"bindings":{"id":"generated.id","short":"input.short","original":"input.original"},"code_id":"code.create"}
{"kind":"measurement","id":"measurement.url-count","world_id":"world.urls","path":"db.urls","operator":"count","compare":"after-before","expected_delta":1}
{"kind":"ac","id":"ac.create","spec_id":"spec.url.create","transition_id":"transition.create","measurement_id":"measurement.url-count","test_id":"test.create","title":"Create a URL","given":"No URL exists for the selected short code","when":"create(short, original)","then":"One URL row appears with id, short and original","required_trials":2}
{"kind":"test_link","id":"test.create","ac_id":"ac.create","path":"url_create.test.mjs","symbol":"create URL persists row and returns id","relation":"verifies","environment":"in-memory PostgreSQL-query adapter (demo)"}
{"kind":"code_link","id":"code.create","transition_id":"transition.create","path":"url_create.mjs","symbol":"createUrl","relation":"implements"}
